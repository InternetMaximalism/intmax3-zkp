pragma solidity ^0.8.29;

// Adversarial probes for the ExponentiationGate (id 8) evaluator, kept CHECKED IN on purpose.
//
// SECURITY (audit F-EXP-A1): the strongest evidence for this gate — differential vectors taken
// from real plonky2, plus the boundary cases below — previously lived only in throwaway files
// outside the repo, so none of it was reproducible from a clean clone. Three of these checks
// exist NOWHERE else in the tree: huge `n`, writing past `num_constraints`, and trailing-wire
// isolation. `ExponentiationGateTest.t.sol` (mirrored upstream in the submodule) covers the
// committed reference vectors; this file covers what that one cannot.
import {Test} from "forge-std/Test.sol";
import {Plonky2GateEvaluator} from "@mle/Plonky2GateEvaluator.sol";

contract ExponentiationAdversarialHarness {
    function eval(uint256[] memory wires, uint256 n, uint256 filter, uint256[] memory acc)
        external pure returns (uint256[] memory) {
        Plonky2GateEvaluator._evalExponentiation(wires, n, filter, acc);
        return acc;
    }
    function combined(
        uint256[] calldata wires, uint256[] calldata pre, uint256 alpha, uint256 ext,
        Plonky2GateEvaluator.GateInfo[] calldata gates, uint256 nsel, uint256 nc, uint256 ngc
    ) external pure returns (uint256) {
        uint256[4] memory pih;
        return Plonky2GateEvaluator.evalCombinedFlat(wires, pre, alpha, ext, pih, gates, nsel, nc, ngc);
    }
}

contract ZZAdversarialExpProbe is Test {
    uint256 constant P = 0xFFFFFFFF00000001;
    ExponentiationAdversarialHarness h;
    function setUp() public { h = new ExponentiationAdversarialHarness(); }

    function _dec(bytes memory b) internal pure returns (uint256 n, uint256[] memory w, uint256[] memory e) {
        (n, w, e) = abi.decode(b, (uint256, uint256[], uint256[]));
    }

    function _blob(uint256 i) internal pure returns (bytes memory) {
        if (i == 0) return hex""; // rand_n1_0
        if (i == 1) return hex""; // rand_n1_1
        if (i == 2) return hex""; // rand_n1_2
        if (i == 3) return hex""; // rand_n2_0
        if (i == 4) return hex""; // rand_n2_1
        if (i == 5) return hex""; // rand_n2_2
        if (i == 6) return hex""; // rand_n3_0
        if (i == 7) return hex""; // rand_n3_1
        if (i == 8) return hex""; // rand_n3_2
        if (i == 9) return hex""; // rand_n4_0
        if (i == 10) return hex""; // rand_n4_1
        if (i == 11) return hex""; // rand_n4_2
        if (i == 12) return hex""; // rand_n5_0
        if (i == 13) return hex""; // rand_n5_1
        if (i == 14) return hex""; // rand_n5_2
        if (i == 15) return hex""; // rand_n7_0
        if (i == 16) return hex""; // rand_n7_1
        if (i == 17) return hex""; // rand_n7_2
        if (i == 18) return hex""; // rand_n8_0
        if (i == 19) return hex""; // rand_n8_1
        if (i == 20) return hex""; // rand_n8_2
        if (i == 21) return hex""; // rand_n16_0
        if (i == 22) return hex""; // rand_n16_1
        if (i == 23) return hex""; // rand_n16_2
        if (i == 24) return hex""; // rand_n31_0
        if (i == 25) return hex""; // rand_n31_1
        if (i == 26) return hex""; // rand_n31_2
        if (i == 27) return hex""; // rand_n32_0
        if (i == 28) return hex""; // rand_n32_1
        if (i == 29) return hex""; // rand_n32_2
        if (i == 30) return hex""; // rand_n63_0
        if (i == 31) return hex""; // rand_n63_1
        if (i == 32) return hex""; // rand_n63_2
        if (i == 33) return hex""; // rand_n65_0
        if (i == 34) return hex""; // rand_n65_1
        if (i == 35) return hex""; // rand_n65_2
        if (i == 36) return hex""; // rand_n66_0
        if (i == 37) return hex""; // rand_n66_1
        if (i == 38) return hex""; // rand_n66_2
        if (i == 39) return hex""; // rand_n100_0
        if (i == 40) return hex""; // rand_n100_1
        if (i == 41) return hex""; // rand_n100_2
        if (i == 42) return hex""; // honest_n1_0
        if (i == 43) return hex""; // honest_n1_1
        if (i == 44) return hex""; // honest_n1_2
        if (i == 45) return hex""; // honest_n2_0
        if (i == 46) return hex""; // honest_n2_1
        if (i == 47) return hex""; // honest_n2_2
        if (i == 48) return hex""; // honest_n3_0
        if (i == 49) return hex""; // honest_n3_1
        if (i == 50) return hex""; // honest_n3_2
        if (i == 51) return hex""; // honest_n8_0
        if (i == 52) return hex""; // honest_n8_1
        if (i == 53) return hex""; // honest_n8_2
        if (i == 54) return hex""; // honest_n66_0
        if (i == 55) return hex""; // honest_n66_1
        if (i == 56) return hex""; // honest_n66_2
        if (i == 57) return hex""; // nonbool_2
        if (i == 58) return hex""; // nonbool_3
        if (i == 59) return hex""; // nonbool_5
        if (i == 60) return hex""; // nonbool_18446744069414584320
        if (i == 61) return hex""; // prevdisc_0
        if (i == 62) return hex""; // prevdisc_1
        if (i == 63) return hex""; // prevdisc_2
        if (i == 64) return hex""; // allzero_n1
        if (i == 65) return hex""; // allzero_n2
        if (i == 66) return hex""; // allzero_n66
        if (i == 67) return hex""; // allone_n1
        if (i == 68) return hex""; // allone_n2
        if (i == 69) return hex""; // allone_n66
        if (i == 70) return hex""; // allmax_n1
        if (i == 71) return hex""; // allmax_n2
        if (i == 72) return hex""; // allmax_n66
        revert("oob");
    }
    uint256 constant NCASES = 73;

    /// Differential vs REAL plonky2 eval_unfiltered output, filter = 1, acc = 0.
    function test_diff_vs_rust_filter1() public view {
        for (uint256 i = 0; i < NCASES; i++) {
            (uint256 n, uint256[] memory w, uint256[] memory e) = _dec(_blob(i));
            uint256[] memory acc = new uint256[](n + 1);
            uint256[] memory got = h.eval(w, n, 1, acc);
            for (uint256 j = 0; j <= n; j++) {
                assertEq(got[j], e[j], string.concat("case ", vm.toString(i), " slot ", vm.toString(j)));
            }
        }
    }

    /// filter scaling: acc must equal filter * expected (mod P), for many filters.
    function test_diff_vs_rust_filter_scaled() public view {
        uint256[5] memory fs = [uint256(1), 2, P - 1, 0x1234567890ABCDEF, P + 7];
        for (uint256 k = 0; k < 5; k++) {
            for (uint256 i = 0; i < NCASES; i++) {
                (uint256 n, uint256[] memory w, uint256[] memory e) = _dec(_blob(i));
                uint256[] memory acc = new uint256[](n + 1);
                uint256[] memory got = h.eval(w, n, fs[k], acc);
                for (uint256 j = 0; j <= n; j++) {
                    assertEq(got[j], mulmod(fs[k] % P, e[j], P), "filter scale");
                }
            }
        }
    }

    /// NON-CANONICAL wire injection: w + k*P must give identical results.
    /// Targets any sub(P, x) not preceded by a reduction (2^256 mod P injection).
    function test_noncanonical_wires_equivalent() public view {
        for (uint256 i = 0; i < NCASES; i++) {
            (uint256 n, uint256[] memory w, uint256[] memory e) = _dec(_blob(i));
            for (uint256 mode = 0; mode < 3; mode++) {
                uint256[] memory wd = new uint256[](w.length);
                for (uint256 j = 0; j < w.length; j++) {
                    uint256 k = mode == 0 ? 1 : (mode == 1 ? 2 : (type(uint256).max - w[j]) / P);
                    wd[j] = w[j] + k * P; // cannot overflow by construction
                }
                uint256[] memory acc = new uint256[](n + 1);
                uint256[] memory got = h.eval(wd, n, 1, acc);
                for (uint256 j = 0; j <= n; j++) {
                    assertEq(got[j], e[j], "noncanonical drift");
                }
            }
        }
    }

    /// Accumulation must be += (matching evaluate_gate_constraints), not =.
    function test_accumulates_not_overwrites() public view {
        for (uint256 i = 0; i < NCASES; i++) {
            (uint256 n, uint256[] memory w, uint256[] memory e) = _dec(_blob(i));
            uint256[] memory acc = new uint256[](n + 3);
            for (uint256 j = 0; j < acc.length; j++) acc[j] = 1000 + j;
            uint256[] memory got = h.eval(w, n, 1, acc);
            for (uint256 j = 0; j <= n; j++) {
                assertEq(got[j], addmod(1000 + j, e[j], P), "not += ");
            }
            // slots beyond n must be untouched (no neighbour-gate corruption)
            for (uint256 j = n + 1; j < acc.length; j++) {
                assertEq(got[j], 1000 + j, "wrote past num_constraints");
            }
        }
    }

    /// Extra trailing wires must be ignored (no read past 2n+2 affecting result).
    function test_extra_trailing_wires_ignored() public view {
        for (uint256 i = 0; i < NCASES; i++) {
            (uint256 n, uint256[] memory w, uint256[] memory e) = _dec(_blob(i));
            uint256[] memory wd = new uint256[](w.length + 5);
            for (uint256 j = 0; j < w.length; j++) wd[j] = w[j];
            for (uint256 j = w.length; j < wd.length; j++) wd[j] = 0xDEADBEEF + j;
            uint256[] memory acc = new uint256[](n + 1);
            uint256[] memory got = h.eval(wd, n, 1, acc);
            for (uint256 j = 0; j <= n; j++) assertEq(got[j], e[j], "trailing leak");
        }
    }

    /// filter == 0 must be a no-op.
    function test_filter_zero_noop() public view {
        for (uint256 i = 0; i < NCASES; i++) {
            (uint256 n, uint256[] memory w, ) = _dec(_blob(i));
            uint256[] memory acc = new uint256[](n + 1);
            for (uint256 j = 0; j <= n; j++) acc[j] = 777 + j;
            uint256[] memory got = h.eval(w, n, 0, acc);
            for (uint256 j = 0; j <= n; j++) assertEq(got[j], 777 + j, "filter 0 not noop");
        }
    }

    /// Fail-closed bounds.
    function test_reverts_n_zero() public {
        uint256[] memory w = new uint256[](8);
        uint256[] memory acc = new uint256[](8);
        vm.expectRevert(bytes("Exponentiation: num_power_bits must be >= 1"));
        h.eval(w, 0, 1, acc);
    }
    function test_reverts_wires_short() public {
        uint256[] memory w = new uint256[](5); // need 2*2+2 = 6
        uint256[] memory acc = new uint256[](8);
        vm.expectRevert(bytes("Exponentiation: wires too short"));
        h.eval(w, 2, 1, acc);
    }
    function test_reverts_acc_short() public {
        uint256[] memory w = new uint256[](6);
        uint256[] memory acc = new uint256[](2); // need 3
        vm.expectRevert(bytes("Exponentiation: constraint slots too few"));
        h.eval(w, 2, 1, acc);
    }
    /// Huge n must revert (checked arithmetic), never OOB-read.
    function test_reverts_huge_n() public {
        uint256[] memory w = new uint256[](64);
        uint256[] memory acc = new uint256[](64);
        vm.expectRevert();
        h.eval(w, type(uint256).max / 2, 1, acc);
        vm.expectRevert();
        h.eval(w, type(uint256).max, 1, acc);
    }

}