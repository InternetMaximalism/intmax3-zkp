pragma solidity ^0.8.24;

import {Vm} from "forge-std/Vm.sol";

/// @title Plonky2Pin
/// @notice Refuses to deploy a real-proof verifier from a polygon-plonky2 checkout that is not the
///         commit this repository pins.
/// @dev `git pull` / `git checkout` move the submodule gitlink but not the files inside it. A clone
///      updated that way compiles the new contracts against the OLD verifier, and every real-proof
///      test then fails with a message that never mentions the submodule (2026-11-27: a reviewer
///      on 663ff7a8 with the PoW-22 checkout saw `fixture: v2 WHIR PoW`). Forge cannot read git,
///      so `contracts/plonky2-pin.json` (generated by `.github/ci/plonky2-pin.sh write`, checked
///      against the gitlink in CI) records the SHA-256 of every Solidity file Forge compiles from
///      the pinned commit, and this check recomputes them from the working tree.
library Plonky2Pin {
    Vm internal constant vm = Vm(address(uint160(uint256(keccak256("hevm cheat code")))));

    string internal constant FIX =
        "Run: git submodule update --init --recursive  (git pull / git checkout do not move submodules)";

    function requirePinned() internal view {
        string memory root = vm.projectRoot();
        string memory manifestPath = string.concat(root, "/plonky2-pin.json");
        require(vm.exists(manifestPath), "plonky2 pin: contracts/plonky2-pin.json is missing");
        string memory manifest = vm.readFile(manifestPath);
        string memory commit = vm.parseJsonString(manifest, ".commit");
        string[] memory paths = vm.parseJsonStringArray(manifest, ".paths");
        bytes32[] memory hashes = vm.parseJsonBytes32Array(manifest, ".sha256");
        require(paths.length != 0 && paths.length == hashes.length, "plonky2 pin: malformed contracts/plonky2-pin.json");

        for (uint256 i = 0; i < paths.length; i++) {
            string memory file = string.concat(root, "/", paths[i]);
            if (!vm.exists(file)) {
                revert(
                    string.concat(
                        "contracts/lib/polygon-plonky2 is not checked out at the pinned commit ",
                        commit,
                        ": ",
                        paths[i],
                        " is missing. ",
                        FIX
                    )
                );
            }
            if (sha256(vm.readFileBinary(file)) != hashes[i]) {
                revert(
                    string.concat(
                        "contracts/lib/polygon-plonky2 is not the commit this repository pins (",
                        commit,
                        "): ",
                        paths[i],
                        " differs. ",
                        FIX
                    )
                );
            }
        }
    }
}
