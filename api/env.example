# Copy to a root-only environment file outside the repository. Do not commit real credentials.
RPC=https://ethereum-sepolia-rpc.publicnode.com
INTMAX_CHANNELS=7,8
INTMAX_WORK_DIR=/var/lib/intmax/wallet-live-work
CHANNEL_MEMBER_BIN=/opt/intmax/bin/channel_member

# Required for every L1 write on a non-31337 chain. Import the funded key once with:
#   cast wallet import intmax-testnet-operator --interactive
# The service passes only `--account <name>` to Foundry. Never set INTMAX_DEPOSIT_KEY in
# production; it is rejected off the local Anvil chain.
INTMAX_L1_ACCOUNT=intmax-testnet-operator

# Non-interactive API calls cannot answer Foundry's password prompt. `ETH_PASSWORD` is Foundry's
# env alias for `--password-file`: point it at a root-only service credential, never at the password
# text itself. Neither this path nor the password is forwarded in child argv.
ETH_PASSWORD=/run/credentials/intmax/l1-keystore-password

FRAUD_TREASURY=0x<20-byte-nonzero-treasury-address>
INTMAX_COSIGNER_KEYFILE=/run/credentials/intmax/cosigner.key
INTMAX_API_TOKEN=
INTMAX_ALLOWED_ORIGINS=https://wallet.example.test
