[submodule "contracts/lib/forge-std"]
	path = contracts/lib/forge-std
	url = https://github.com/foundry-rs/forge-std
[submodule "contracts/lib/polygon-plonky2"]
	path = contracts/lib/polygon-plonky2
	url = https://github.com/InternetMaximalism/intmax-plonky2.git
	# Release builds must use `git submodule update --init --recursive`, not --remote.
	# The gitlink pins the tested merge of wire-v3/main legacy isolation and the
	# target-105/inverse-rate-6 optimizations. Do not replace it with the older
	# feature branch, main, or mleintroduction (which lacks the Solidity verifier).
	branch = codex/mle-node-safety-integration-20260906
