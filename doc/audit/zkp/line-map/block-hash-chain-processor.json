  "boundaries": [
    {
      "name": "plonky2-proving-and-verification",
      "obligation": "Every `prove` and `verify` call is an opaque callback returning success or failure; nothing in the model implies proof soundness, completeness, zero-knowledge, or recursive-verification soundness.",
      "discharged": false
    },
    {
      "name": "circuit-construction-lowering",
      "obligation": "`generate_cd`, each circuit's `new`, and `verifier_data()` lower to plonky2 gates that the model does not represent; the build plan records dependency order only.",
      "discharged": false
    },
    {
      "name": "cyclic-verifier-key-equality",
      "obligation": "The model records that the chain circuit's own verifier data is passed into the step circuit, but does not prove that this key equals the key a verified proof was produced under.",
      "discharged": false
    },
    {
      "name": "hash-chain-and-merkle-semantics",
      "obligation": "Deposits, registration records, digests, Merkle proofs and tree roots are opaque payloads; no hashing, Merkle membership or chain-folding semantics is modeled.",
      "discharged": false
    },
    {
      "name": "block-chain-public-input-codec",
      "obligation": "`BlockChainPublicInputs::from_u64_slice` is an opaque parser returning the previous extended public state; the model does not re-derive the encoding or prove it matches the circuit's public inputs.",
      "discharged": false
    },
    {
      "name": "witness-generator-refusal",
      "obligation": "The SECURITY (M-2) claim that `BlockWitnessGenerator::add_block_with_tx_v2_inner` refuses to construct a ChannelAction block with a `None` action witness lives in another file and is not modeled here.",
      "discharged": false
    },
    {
      "name": "update-user-circuit-selection",
      "obligation": "Selecting a circuit by user count is modeled as a lookup in a registered list; that the selected circuit actually constrains that many users is not modeled.",
      "discharged": false
    },
    {
      "name": "block-number-arithmetic",
      "obligation": "`U63::add` is modeled as `Nat` successor with an explicit `u63Max` bound; the u64 `checked_add` plus `U63::new` range check is not proved equivalent.",
      "discharged": false
    }
  ]
