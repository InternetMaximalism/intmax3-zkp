  "boundaries": [
    {
      "name": "StarkSoundness",
      "obligation": "stark::prove_batch / verify_batch, the FRI PCS, the hiding (zero-knowledge) config and the Fiat-Shamir challenger are an opaque callback; that an accepted proof implies the claimed statement (or that a diverged transcript rejects) is assumed, never proved.",
      "discharged": false
    },
    {
      "name": "EvaluationArgumentSoundness",
      "obligation": "That agreement of the published evaluations at the post-commitment challenge z pins the committed trace columns to the claimed public polynomials (Schwartz-Zippel over the quartic BabyBear extension) is assumed; the model compares evaluations structurally with Chal = Int.",
      "discharged": false
    },
    {
      "name": "FieldProducts",
      "obligation": "Primality of q, i.e. that a product vanishing mod q has a vanishing factor; the premise that turns the cubic/quadratic smallness gates into membership facts. Taken as an explicit hypothesis.",
      "discharged": false
    },
    {
      "name": "UpstreamRegev",
      "obligation": "regev_plonky3 keygen/encrypt/encode_value_message, RegevParams::delta(), the negacyclic NTT, config.is_zk() and the postcard codec are not translated; encodeAmount models the documented D1 encoding only.",
      "discharged": false
    },
    {
      "name": "LatticeHardness",
      "obligation": "Ring-LWE hardness at n = 2048 and the noise/digit budget analysis of params.rs; no secrecy or indistinguishability claim is made here.",
      "discharged": false
    },
    {
      "name": "Plonky3Lowering",
      "obligation": "That the Rust AIR impls (BaseAir/Air/LookupAir, symbolic expression construction, trace LDE) really enforce the constraint families the model states is assumed.",
      "discharged": false
    },
    {
      "name": "NativeTargetRefinement",
      "obligation": "Rust integer/array/allocation behaviour, error message strings (errors are modelled payload-free) and prover-side witness construction are not translated.",
      "discharged": false
    }
  ]
}
